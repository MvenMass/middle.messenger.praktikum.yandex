<main class="messenger">
  <h1 class="visually-hidden">Чаты</h1>

  <aside class="messenger__sidebar">
    <header class="sidebar-header">
      <nav class="sidebar-header__nav">
        <a class="sidebar-header__button" href="/settings" aria-label="Настройки профиля">
          {{> IconMenu}}
        </a>
      </nav>
      {{{search}}}
      <button class="sidebar-header__button" type="button" aria-label="Создать чат" data-action="create-chat">
        {{> IconPlus}}
      </button>
    </header>

    <ul class="chat-list">
      {{#each chats}}
        <li>
          <button class="chat-preview{{#if isActive}} chat-preview_active{{/if}}" type="button" data-chat-id="{{id}}">
            {{> Avatar avatar size="medium"}}
            <span class="chat-preview__body">
              <span class="chat-preview__row">
                <span class="chat-preview__title">{{title}}</span>
                <span class="chat-preview__time">{{time}}</span>
              </span>
              <span class="chat-preview__row">
                <span class="chat-preview__message">{{lastMessage}}</span>
                {{#if unreadCount}}
                  <span class="chat-preview__badge">{{unreadCount}}</span>
                {{/if}}
              </span>
            </span>
          </button>
        </li>
      {{else}}
        <li class="chat-list__empty">Чатов пока нет. Создайте первый с помощью кнопки «+»</li>
      {{/each}}
    </ul>
  </aside>

  <section class="chat">
    {{#if activeChat}}
      <header class="chat__header">
        {{> Avatar activeChat.avatar size="small"}}
        <h2 class="chat__title">{{activeChat.title}}</h2>
        {{{chatMenu}}}
      </header>

      <div class="chat__feed">
        <p class="chat__notice">Сообщений пока нет</p>
      </div>

      {{{composer}}}
    {{else}}
      <div class="chat__feed">
        <p class="chat__notice">Выберите чат, чтобы начать общение</p>
      </div>
    {{/if}}
  </section>

  {{{createChatModal}}}
  {{{addUserModal}}}
  {{{removeUserModal}}}
</main>
