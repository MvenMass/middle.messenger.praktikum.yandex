<div class="chat-menu">
  <button class="chat-menu__toggle" type="button" aria-label="Действия с чатом" aria-expanded="{{isOpen}}" data-action="toggle">
    {{> IconMore}}
  </button>
  {{#if isOpen}}
    <ul class="chat-menu__list">
      {{#each items}}
        <li>
          <button class="chat-menu__item{{#if isDanger}} chat-menu__item_danger{{/if}}" type="button" data-index="{{@index}}">{{text}}</button>
        </li>
      {{/each}}
    </ul>
  {{/if}}
</div>
