<div class="message-feed">
  {{#if statusText}}
    <p class="message-feed__status">{{statusText}}</p>
  {{/if}}
  <div class="message-feed__scroller">
    <ul class="message-feed__list">
      {{#each messages}}
        {{> Message this}}
      {{else}}
        <li class="message-feed__empty">Сообщений пока нет</li>
      {{/each}}
    </ul>
  </div>
</div>
