<form class="composer{{#if error}} composer_invalid{{/if}}" novalidate>
  <p class="composer__error" role="alert">{{error}}</p>
  <label class="composer__field">
    <span class="visually-hidden">Сообщение</span>
    {{{input}}}
  </label>
  <button class="composer__send" type="submit" aria-label="Отправить">
    {{> IconSend}}
  </button>
</form>
