<form class="form chat-avatar-form" novalidate>
  <label class="chat-avatar-form__field">
    <span class="chat-avatar-form__label">Картинка для чата</span>
    <input class="chat-avatar-form__input" type="file" name="avatar" accept="image/*">
  </label>
  <p class="form__message form__message_error">{{error}}</p>
  {{{submitButton}}}
</form>
